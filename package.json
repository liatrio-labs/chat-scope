{
  "name": "@liatrio/chat-scope",
  "version": "0.2.2",
  "description": "Search and explore AI coding assistant session history across multiple providers",
  "type": "module",
  "bin": {
    "chat-scope": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:server": "tsx watch api/index.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsup api/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tanstack/react-virtual": "^3.13.14",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "diff": "^8.0.2",
    "hono": "^4.7.8",
    "lucide-react": "^0.562.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.0.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "chat",
    "session",
    "index",
    "search",
    "claude",
    "codex",
    "cursor",
    "opencode",
    "cli",
    "conversation",
    "ai"
  ],
  "author": "Liatrio Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liatrio-labs/chat-scope.git"
  },
  "homepage": "https://github.com/liatrio-labs/chat-scope#readme",
  "bugs": {
    "url": "https://github.com/liatrio-labs/chat-scope/issues"
  }
}
